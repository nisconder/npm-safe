{
  "name": "@npm-safe/desktop",
  "version": "1.0.5",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Desktop GUI for @npm-safe core, built with Neutralinojs",
  "scripts": {
    "build:core": "pnpm -F @npm-safe/core run build",
    "prebuild": "neu update",
    "run": "pnpm run build:core && neu update && neu run",
    "build": "pnpm run build:core && neu build --release"
  },
  "dependencies": {
    "@npm-safe/core": "workspace:*"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.0.0"
  }
}
