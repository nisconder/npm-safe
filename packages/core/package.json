{
  "name": "@npm-safe/core",
  "version": "1.0.0",
  "description": "Local npm package security engine: static and LLM-based supply-chain analysis, SQLite cache, CLI and desktop GUI.",
  "keywords": ["npm", "security", "supply-chain", "scanner", "static-analysis", "llm", "cli"],
  "license": "Apache-2.0",
  "author": "Nisconder",
  "homepage": "https://github.com/nisconder/npm-safe",
  "repository": { "type": "git", "url": "git+https://github.com/nisconder/npm-safe.git" },
  "bugs": { "url": "https://github.com/nisconder/npm-safe/issues" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "npm-safe": "./dist/cli/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "scripts/install-skill.mjs"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "commander": "^15.0.0",
    "type-fest": "^4.0.0",
    "undici": "^7.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:cli": "tsc -p tsconfig.json",
    "postinstall": "node scripts/install-skill.mjs",
    "test": "node --import tsx --test --test-reporter spec \"test/**/*.test.ts\""
  }
}
