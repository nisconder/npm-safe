      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "commander": "^15.0.0",
    "type-fest": "^4.0.0",
    "undici": "^7.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:cli": "tsc -p tsconfig.json",
    "postinstall": "node scripts/install-skill.mjs",
    "test": "node --import tsx --test --test-reporter spec \"test/**/*.test.ts\""
  }
}
