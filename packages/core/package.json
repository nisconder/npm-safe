{
  "name": "@npm-safe/core",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "npm-safe": "./dist/cli/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "scripts/install-skill.mjs"
  ],
  "exports": {
